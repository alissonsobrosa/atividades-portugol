programa {
  funcao inicio() {
    // entendimento do problema
    // calcular o horário de retorno do recreio
    // info e variáveis
    inteiro hora, minuto 
    // entrada de dados
    escreva( "hora do começo: ")
    leia(hora)
    escreva( "minuto do começo: ")
    leia(minuto)
    // processamento
    minuto = minuto + 20
    // saida
    escreva("recreio termina ")
    escreva(hora)
    escreva(":")
    escreva(minuto)
    // escreva("oque acontece com quem chega depois do horário?")

  }
}
